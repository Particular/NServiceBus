<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrimmedEndpoint</AssemblyName>
    <RootNamespace>TrimmedEndpoint</RootNamespace>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);NServiceBus</InterceptorsNamespaces>
    <!-- Test fixture: self-hosted endpoint, top-level awaits, and static completion flag are intentional. -->
    <NoWarn>$(NoWarn);CS0618;CA2007;CA1050;CA2211</NoWarn>
    <!-- Project-local so the property does not flow to referenced projects (the netstandard2.0 analyzer cannot be trimmed). -->
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup Label="Core Analyzers">
    <ProjectReference Include="..\NServiceBus.Core.Analyzer\NServiceBus.Core.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NServiceBus.Core\NServiceBus.Core.csproj" />
  </ItemGroup>

</Project>
