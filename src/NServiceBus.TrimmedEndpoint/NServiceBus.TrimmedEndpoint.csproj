<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrimmedEndpoint</AssemblyName>
    <RootNamespace>TrimmedEndpoint</RootNamespace>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);NServiceBus</InterceptorsNamespaces>
    <!-- Test fixture: self-hosted endpoint, top-level awaits, and static completion flag are intentional. -->
    <NoWarn>$(NoWarn);CS0618;CA2007;CA1050;CA2211</NoWarn>
    <!-- Project-local so the property does not flow to referenced projects (the netstandard2.0 analyzer cannot be trimmed or AOT-compiled). -->
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Set by the AOT validation test via -p:RunAotValidation=true; stays project-local so it does not flow to the analyzer project. -->
    <PublishAot Condition="'$(RunAotValidation)' == 'true'">true</PublishAot>
    <!-- The saga scenario crashes the .NET 10 ILLink trimmer (Mono.Linker MessageOrigin.ToString on generated-method warnings);
         it is compiled only into the NativeAOT build where the ILC pipeline is unaffected. -->
    <DefineConstants Condition="'$(RunAotValidation)' == 'true'">$(DefineConstants);INCLUDE_SAGA</DefineConstants>
  </PropertyGroup>

  <ItemGroup Label="Core Analyzers">
    <ProjectReference Include="..\NServiceBus.Core.Analyzer\NServiceBus.Core.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NServiceBus.Core\NServiceBus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NServiceBus.props normally declares these when the package is referenced. -->
    <CompilerVisibleProperty Include="PublishTrimmed" />
    <CompilerVisibleProperty Include="PublishAot" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="NServiceBus.Core.Hosting.UseV2DeterministicGuid" Value="true" />
  </ItemGroup>

</Project>
